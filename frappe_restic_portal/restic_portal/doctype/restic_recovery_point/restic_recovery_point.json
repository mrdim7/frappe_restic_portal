{
  "doctype": "DocType",
  "name": "Restic Recovery Point",
  "module": "Restic Portal",
  "custom": 0,
  "autoname": "field:snapshot",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_rename": 0,
  "fields": [
    {
      "fieldname": "snapshot",
      "fieldtype": "Data",
      "label": "Snapshot ID",
      "reqd": 1,
      "unique": 1,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "backup_time",
      "fieldtype": "Data",
      "label": "Backup time (ISO 8601)",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "trigger",
      "fieldtype": "Select",
      "label": "Backup type",
      "options": "scheduled\nmanual\nunclassified",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "active",
      "fieldtype": "Check",
      "label": "Available",
      "default": "1",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "verified_at",
      "fieldtype": "Datetime",
      "label": "Verified by platform at",
      "read_only": 1
    }
  ],
  "field_order": [
    "snapshot",
    "backup_time",
    "trigger",
    "active",
    "verified_at"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "select": 1,
      "report": 1,
      "export": 0,
      "write": 0,
      "create": 0,
      "delete": 0
    }
  ],
  "sort_field": "backup_time",
  "sort_order": "DESC",
  "istable": 0,
  "is_submittable": 0,
  "editable_grid": 0,
  "index_web_pages_for_search": 0,
  "allow_copy": 0,
  "quick_entry": 0,
  "track_seen": 1,
  "hide_toolbar": 0,
  "naming_rule": "By fieldname",
  "title_field": "snapshot",
  "search_fields": "snapshot,backup_time"
}
